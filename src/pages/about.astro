---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import GitHubStats from "@/components/mdx/GitHubStats.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="About">
  <MainCard
    title="关于我"
    description="hyk (sai-7i) — 二进制安全、CTF 与工具控。"
    textOverlay="ABOUT"
    infoIcon="lucide:user"
  >
    <div class="space-y-10 mb-8">
      <!-- Profile Section -->
      <section class="flex flex-col md:flex-row gap-8 items-center md:items-start">
        <div class="avatar">
          <div
            class="w-32 h-32 md:w-40 md:h-40 rounded-xl ring ring-primary ring-offset-base-100 ring-offset-2 overflow-hidden"
          >
            <img src="/profile.png" alt="hyk" width="160" height="160" loading="eager" />
          </div>
        </div>

        <div class="flex-1 text-center md:text-left">
          <h2 class="text-3xl md:text-4xl font-bold mb-2">hyk</h2>
          <p class="text-xl text-base-content/80 mb-4">Binary Security & CTF</p>

          <div class="flex flex-wrap gap-3 justify-center md:justify-start mb-6">
            <a
              href="https://github.com/sai-7i"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-outline gap-2"
            >
              <Icon name="lucide:github" class="w-4 h-4" />
              <span>GitHub</span>
            </a>
            <a href="/rss.xml" class="btn btn-sm btn-outline gap-2">
              <Icon name="lucide:rss" class="w-4 h-4" />
              <span>RSS</span>
            </a>
          </div>

          <p class="text-base-content/80">
            我是 hyk，网名 sai-7i。主要方向是二进制安全：CTF 里的 pwn 和 reverse，偶尔也看看 web。喜欢把做题过程整理成可复现的笔记——包括走不通的尝试，因为踩过的坑往往比结论更有用。
          </p>
        </div>
      </section>

      <!-- GitHub Stats -->
      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:github" class="w-6 h-6 text-primary" />
          <span>GitHub Statistics</span>
        </h2>

        <GitHubStats username="sai-7i" />
      </section>

      <!-- Tech Stack -->
      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:cpu" class="w-6 h-6 text-primary" />
          <span>常用技术栈</span>
        </h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
          {
            [
              { name: "Python", icon: "simple-icons:python", color: "oklch(0.7 0.2 250)" },
              { name: "C", icon: "simple-icons:c", color: "oklch(0.6 0.2 240)" },
              { name: "C++", icon: "simple-icons:cplusplus", color: "oklch(0.6 0.2 240)" },
              { name: "Linux", icon: "simple-icons:linux", color: "oklch(0.8 0.2 80)" },
              { name: "Bash", icon: "simple-icons:gnubash", color: "oklch(0.7 0.2 140)" },
              { name: "Git", icon: "simple-icons:git", color: "oklch(0.7 0.2 30)" },
              { name: "Docker", icon: "simple-icons:docker", color: "oklch(0.6 0.2 230)" },
              { name: "Astro", icon: "simple-icons:astro", color: "oklch(0.5 0.2 300)" },
              { name: "TypeScript", icon: "simple-icons:typescript", color: "oklch(0.6 0.2 250)" },
              { name: "Vue", icon: "simple-icons:vuedotjs", color: "oklch(0.7 0.2 160)" },
              { name: "FastAPI", icon: "simple-icons:fastapi", color: "oklch(0.7 0.2 180)" },
              { name: "SQLite", icon: "simple-icons:sqlite", color: "oklch(0.6 0.2 220)" },
            ].map((tech) => (
              <div class="flex flex-col items-center justify-center p-4 bg-base-200 rounded-lg hover:bg-base-300 transition-colors">
                <div class="text-3xl mb-2" style={`color: ${tech.color}`}>
                  <Icon name={tech.icon} class="w-10 h-10" />
                </div>
                <span class="text-sm font-medium">{tech.name}</span>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </MainCard>
</BaseLayout>
