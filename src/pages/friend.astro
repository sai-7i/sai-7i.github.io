---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import LinkCard from "@/components/mdx/LinkCard.astro";
import CardGroup from "@/components/temple/CardGroup.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Friends">
  <CardGroup cols="1">
    <MainCard
      title="友链与资源"
      description="各位师傅能来看我的博客，实属在下幸事，通过 QQ 3377256183 联系我，一起交流进步"
      textOverlay="FRIENDS"
      infoIcon="lucide:link"
    >
      <div class="space-y-10">
        <!-- Friends Section -->
        <section>
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
            <Icon name="lucide:users" class="w-6 h-6 text-primary" />
            <span>友链</span>
          </h2>

          <div class="card bg-base-200 p-6">
            <p class="text-base-content/80">
              这里还没有友链。想交换的话，到
              <a
                href="https://github.com/sai-7i"
                target="_blank"
                rel="noopener noreferrer"
                class="link link-primary font-bold">GitHub</a
              >
              找我，或者在
              <a
                href="https://github.com/sai-7i/sai-7i.github.io/issues"
                target="_blank"
                rel="noopener noreferrer"
                class="link link-primary font-bold">Issues</a
              >
              里留言，附上站点名称、地址和一句话介绍即可。
            </p>
          </div>
        </section>

        <!-- Useful Resources Section -->
        <section>
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
            <Icon name="lucide:bookmark" class="w-6 h-6 text-primary" />
            <span>常用资源</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <LinkCard
              title="CTF Wiki"
              desc="CTF 各方向的入门与进阶笔记，pwn、reverse、web、crypto 都有体系化的整理。"
              url="https://ctf-wiki.org/"
              icon="lucide:book-open"
              categories={["CTF", "Wiki"]}
            />

            <LinkCard
              title="pwntools 文档"
              desc="pwn 题必备的 Python 库：tube 交互、ELF 解析、ROP 链构造与 shellcraft。"
              url="https://docs.pwntools.com/"
              icon="lucide:terminal"
              categories={["Docs", "Pwn"]}
            />

            <LinkCard
              title="how2heap"
              desc="glibc 堆利用技巧合集，按 libc 版本分类，每个技巧都带可运行的示例。"
              url="https://github.com/shellphish/how2heap"
              icon="lucide:bug"
              categories={["Heap", "Pwn"]}
            />

            <LinkCard
              title="pwndbg"
              desc="把 gdb 变成二进制分析工具：内存布局、堆结构、ROP 与栈溢出调试都更直观。"
              url="https://pwndbg.re/"
              icon="lucide:wrench"
              categories={["Tools", "Debug"]}
            />
          </div>
        </section>
      </div>
    </MainCard>
  </CardGroup>
</BaseLayout>
