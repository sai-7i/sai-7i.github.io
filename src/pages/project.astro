---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import GitHubStats from "@/components/mdx/GitHubStats.astro";
import RepositoryCard from "@/components/mdx/RepositoryCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Projects">
  <MainCard
    title="项目"
    description="我在 GitHub 上维护的开源项目与实验性工具。"
    textOverlay="PROJECTS"
    infoIcon="lucide:folder"
  >
    <!-- Featured Project -->
    <section class="py-4">
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <Icon name="lucide:star" class="w-6 h-6 text-primary" />
        <span>本博客</span>
      </h2>

      <GitHubStats username="sai-7i" repositoryName="sai-7i.github.io" />
    </section>

    <!-- My Repositories -->
    <section class="py-4">
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <Icon name="lucide:folder" class="w-6 h-6 text-primary" />
        <span>我的仓库</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <RepositoryCard repo="sai-7i/sai-7i.github.io" isPinned={true} />
        <RepositoryCard repo="sai-7i/daxue-zhidao" isPinned={true} />
        <RepositoryCard repo="sai-7i/cloud-scheduler-simulator" />
        <RepositoryCard repo="sai-7i/songling" />
        <RepositoryCard repo="sai-7i/Aboard" />
      </div>

      <div class="flex justify-center mt-10">
        <a
          href="https://github.com/sai-7i?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline gap-2"
        >
          <Icon name="lucide:github" class="w-5 h-5" />
          <span>在 GitHub 上查看更多</span>
        </a>
      </div>
    </section>
  </MainCard>
</BaseLayout>
