---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import FeatureCard from "@/components/mdx/FeatureCard.astro";
import GitHubStats from "@/components/mdx/GitHubStats.astro";
import PostCard from "@/components/PostCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllPosts, getPostsWithStats, sortPostsByPinAndDate } from "@utils/blogUtils";

const sortedPosts = sortPostsByPinAndDate(await getAllPosts());
const latestPosts = (await getPostsWithStats(sortedPosts)).slice(0, 3);
---

<BaseLayout title="Home">
  <MainCard
    title="hyk's blog"
    description="二进制安全、CTF 与工程踩坑笔记。"
    textOverlay="HOME"
    infoIcon="lucide:info"
  >
    <div class="space-y-8">
      <!-- Hero Section -->
      <section class="py-6">
        <div class="flex flex-col items-center text-center">
          <h2
            class="text-4xl font-bold mb-4 bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent leading-loose"
          >
            👋 你好，我是 hyk
          </h2>
          <p class="text-xl text-base-content/80 max-w-3xl mb-8">
            二进制安全爱好者：CTF pwn、逆向分析、漏洞利用，也写点提高效率的小工具。这里是我的做题笔记与踩坑记录。
          </p>
          <div class="flex flex-wrap gap-4 justify-center">
            <a href="/blog" class="btn btn-primary gap-2 btn-shine-effect">
              <Icon name="lucide:book-open" class="w-5 h-5" />
              <span>阅读博客</span>
            </a>
            <a href="https://github.com/sai-7i" target="_blank" rel="noopener noreferrer" class="btn btn-outline gap-2">
              <Icon name="lucide:github" class="w-5 h-5" />
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </section>

      <!-- What I Do -->
      <section class="py-6">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:sparkles" class="w-6 h-6 text-primary" />
          <span>我在做什么</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <FeatureCard
            title="CTF Pwn"
            description="栈溢出、堆利用、ROP 链，glibc 版本差异与比赛复盘。"
            icon="lucide:bug"
            color="oklch(0.7 0.2 30)"
          />

          <FeatureCard
            title="逆向分析"
            description="IDA / Ghidra 静态分析，还原混淆逻辑与自定义虚拟机。"
            icon="lucide:binary"
            color="oklch(0.65 0.2 280)"
          />

          <FeatureCard
            title="Web 安全"
            description="越权、注入、SSRF 一类的实战记录，以及白盒代码审计。"
            icon="lucide:globe"
            color="oklch(0.6 0.2 160)"
          />

          <FeatureCard
            title="工具与脚本"
            description="用 pwntools 和 Python 把重复劳动写掉，能自动化就自动化。"
            icon="lucide:wrench"
            color="oklch(0.6 0.2 200)"
          />

          <FeatureCard
            title="工程实践"
            description="Astro / Vue / FastAPI 搭小项目，顺手记录踩过的坑。"
            icon="lucide:boxes"
            color="oklch(0.8 0.2 80)"
          />

          <FeatureCard
            title="学习记录"
            description="一次只学一个可验证的小单元，学完就写下来。"
            icon="lucide:book-open"
            color="oklch(0.7 0.2 10)"
          />
        </div>
      </section>

      <!-- Latest Posts -->
      <section class="py-6">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <h2 class="text-2xl font-bold flex items-center gap-2">
            <Icon name="lucide:notebook-pen" class="w-6 h-6 text-primary" />
            <span>最新文章</span>
          </h2>
          <a href="/blog" class="btn btn-sm btn-outline gap-2">
            <span>全部文章</span>
            <Icon name="lucide:external-link" class="w-4 h-4" />
          </a>
        </div>

        <div class="flex flex-col gap-6">
          {
            latestPosts.map((post, index) => (
              <PostCard
                priority={index === 0}
                title={post.data.title}
                image={post.data.image}
                description={post.data.description}
                url={"/blog/" + post.id}
                pubDate={post.data.pubDate}
                badge={post.data.badge}
                categories={post.data.categories}
                tags={post.data.tags}
                word={post.remarkPluginFrontmatter.totalCharCount}
                time={post.remarkPluginFrontmatter.readingTime}
              />
            ))
          }
        </div>
      </section>

      <!-- GitHub Stats -->
      <section class="py-6">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:github" class="w-6 h-6 text-primary" />
          <span>GitHub 数据</span>
        </h2>

        <GitHubStats username="sai-7i" />
      </section>
    </div>
  </MainCard>
</BaseLayout>
