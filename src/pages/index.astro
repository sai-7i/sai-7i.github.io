---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import FeatureCard from "@/components/mdx/FeatureCard.astro";
import GitHubStats from "@/components/mdx/GitHubStats.astro";
import PostCard from "@/components/PostCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllPosts, getPostsWithStats, sortPostsByPinAndDate } from "@utils/blogUtils";

const sortedPosts = sortPostsByPinAndDate(await getAllPosts());
const latestPosts = (await getPostsWithStats(sortedPosts)).slice(0, 3);
---

<BaseLayout title="Home">
  <MainCard
    title="hyk's blog"
    description="二进制安全、linux kernel研究。"
    image="/image/hero.jpg"
    textOverlay="HOME"
    infoIcon="lucide:info"
  >
    <div class="space-y-8">
      <!-- Hero Section -->
      <section class="py-6">
        <div class="flex flex-col items-center text-center">
          <h2
            class="text-4xl font-bold mb-4 bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent leading-loose"
          >
            0x7c00
          </h2>
          <p class="text-xl text-base-content/80 max-w-3xl mb-3">
            爱意宽大是无限
          </p>
          <p class="mb-8 font-mono text-sm text-base-content/45">
            $ whoami → binary security · linux kernel · exploit
          </p>
          <div class="flex flex-wrap gap-4 justify-center">
            <a href="/blog" class="btn btn-primary gap-2 btn-shine-effect">
              <Icon name="lucide:book-open" class="w-5 h-5" />
              <span>阅读博客</span>
            </a>
            <a href="https://github.com/sai-7i" target="_blank" rel="noopener noreferrer" class="btn btn-outline gap-2">
              <Icon name="lucide:github" class="w-5 h-5" />
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </section>

      <!-- What I Do -->
      <section class="py-6">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:sparkles" class="w-6 h-6 text-primary" />
          <span>My World</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <FeatureCard
            title="二进制分析"
            icon="lucide:binary"
            color="oklch(0.65 0.2 280)"
            tags={["elf", "ida", "ghidra", "pwntools"]}
          />

          <FeatureCard
            title="Linux"
            icon="lucide:terminal"
            color="oklch(0.8 0.18 80)"
            tags={["syscall", "ebpf", "kernel module"]}
          />

          <FeatureCard
            title="CVE利用与渗透"
            icon="lucide:shield-alert"
            hoverIcon="lucide:crosshair"
            color="oklch(0.62 0.22 25)"
            tags={["cve", "exploit", "privilege escalation"]}
          />

          <FeatureCard
            title="操作系统"
            icon="lucide:cpu"
            color="oklch(0.6 0.2 200)"
            tags={["scheduler", "mm", "interrupt"]}
          />

          <FeatureCard
            title="AI 与 Agent"
            icon="lucide:brain-circuit"
            color="oklch(0.7 0.2 300)"
            glow
            tags={["llm", "agent", "rfc"]}
          />

          <FeatureCard
            title="Blog"
            icon="lucide:compass"
            color="oklch(0.7 0.2 10)"
            tags={["writeup", "notes"]}
          />
        </div>
      </section>

      <!-- Latest Posts -->
      <section class="py-6">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <h2 class="text-2xl font-bold flex items-center gap-2">
            <Icon name="lucide:notebook-pen" class="w-6 h-6 text-primary" />
            <span>最新文章</span>
          </h2>
          <a href="/blog" class="btn btn-sm btn-outline gap-2">
            <span>全部文章</span>
            <Icon name="lucide:external-link" class="w-4 h-4" />
          </a>
        </div>

        <div class="flex flex-col gap-6">
          {
            latestPosts.map((post, index) => (
              <PostCard
                priority={index === 0}
                title={post.data.title}
                image={post.data.image}
                description={post.data.description}
                url={"/blog/" + post.id}
                pubDate={post.data.pubDate}
                badge={post.data.badge}
                categories={post.data.categories}
                tags={post.data.tags}
                word={post.remarkPluginFrontmatter.totalCharCount}
                time={post.remarkPluginFrontmatter.readingTime}
              />
            ))
          }
        </div>
      </section>

      <!-- GitHub Stats -->
      <section class="py-6">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:github" class="w-6 h-6 text-primary" />
          <span>GitHub 数据</span>
        </h2>

        <GitHubStats username="sai-7i" />
      </section>
    </div>
  </MainCard>
</BaseLayout>
