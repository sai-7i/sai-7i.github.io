---
export interface FeatureCardProps {
  title: string;
  /** 可选的小字介绍 */
  description?: string;
  icon: string;
  color?: string;
  /** 悬停时切换的图标（如 shield-alert → crosshair） */
  hoverIcon?: string;
  /** 卡片底部的小标签，如 ["syscall", "ebpf"] */
  tags?: string[];
  /** 是否显示呼吸光晕（用于强调卡片） */
  glow?: boolean;
  /** 透传额外 class */
  class?: string;
}

const {
  title,
  description,
  icon,
  color = "oklch(0.6 0.2 250)", // Default blue color
  hoverIcon,
  tags = [],
  glow = false,
  class: className = "",
} = Astro.props as FeatureCardProps;

import { Icon } from "astro-icon/components";
---

<div
  class:list={[
    "group card relative overflow-hidden bg-base-100 shadow-md hover:shadow-xl transition-transform duration-300 ease-in-out hover:-translate-y-1 border border-base-200",
    className,
  ]}
>
  {
    glow && (
      <div
        class="pointer-events-none absolute -right-8 -top-8 h-28 w-28 rounded-full opacity-30 blur-2xl animate-pulse"
        style={`background-color: ${color};`}
        aria-hidden="true"
      />
    )
  }

  <div class="card-body p-6">
    <div class="flex flex-col items-center text-center">
      <div
        class="mb-4 rounded-lg p-3 transition-transform duration-300 group-hover:scale-110"
        style={`background-color: color-mix(in oklch, ${color}, transparent 90%); color: ${color};`}
      >
        <div class="relative">
          <Icon
            name={icon}
            class:list={[
              "w-8 h-8",
              hoverIcon ? "transition-opacity duration-200 group-hover:opacity-0" : "",
            ]}
          />
          {
            hoverIcon && (
              <Icon
                name={hoverIcon}
                class="absolute inset-0 w-8 h-8 opacity-0 transition-opacity duration-200 group-hover:opacity-100"
              />
            )
          }
        </div>
      </div>

      <h3 class="text-xl font-bold">{title}</h3>

      {description && <p class="mt-2 text-base-content/70">{description}</p>}

      {
        tags.length > 0 && (
          <div class="mt-3 flex flex-wrap justify-center gap-1.5">
            {tags.map((tag) => (
              <span class="rounded-full border border-base-300 px-2 py-0.5 font-mono text-[11px] text-base-content/55">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>
